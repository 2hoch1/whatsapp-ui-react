{
  "extends": "@whatsapp-ui/typescript/nextjs",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
