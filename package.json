{
  "name": "whatsapp-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for whatsapp-ui-react: React components with a WhatsApp Web-inspired UI.",
  "homepage": "https://github.com/2hoch1/whatsapp-ui-react#readme",
  "bugs": {
    "url": "https://github.com/2hoch1/whatsapp-ui-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hoch1/whatsapp-ui-react.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "turbo run registry:build",
    "release": "turbo run build --filter=./packages/* && pnpm changeset publish",
    "version": "pnpm changeset version && pnpm install --lockfile-only",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@whatsapp-ui/eslint": "workspace:*",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">= 24.14.0",
    "pnpm": ">=10"
  }
}
