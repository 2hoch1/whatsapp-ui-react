  },
  "devDependencies": {
    "@whatsapp-ui/eslint": "workspace:*",
    "@whatsapp-ui/typescript": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
