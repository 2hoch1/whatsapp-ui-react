{
  "name": "whatsapp-ui-react",
  "version": "0.1.0",
  "description": "React component library with a WhatsApp Web-inspired UI.",
  "keywords": [
    "react",
    "whatsapp",
    "chat",
    "ui",
    "component",
    "tailwindcss",
    "shadcn"
  ],
  "homepage": "https://github.com/2hoch1/whatsapp-ui-react#readme",
  "bugs": {
    "url": "https://github.com/2hoch1/whatsapp-ui-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hoch1/whatsapp-ui-react.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./css/*": "./src/css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "src",
    "registry.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "registry:json": "tsx registry/build-registry-json.ts",
    "registry:build": "pnpm registry:json && shadcn build registry.json --output ../../apps/docs/public/r",
    "clean": "rimraf dist css"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@whatsapp-ui/eslint": "workspace:*",
    "@whatsapp-ui/typescript": "workspace:*",
    "jsdom": "^26.0.0",
    "rimraf": "^6.1.3",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
