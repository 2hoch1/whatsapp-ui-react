{
  "name": "whatsapp-ui-react",
  "version": "0.1.0",
  "description": "React component library with a WhatsApp Web-inspired UI.",
  "keywords": [
    "react",
    "whatsapp",
    "chat",
    "ui",
    "component",
    "tailwindcss",
    "shadcn"
  ],
  "homepage": "https://github.com/2hoch1/whatsapp-ui-react#readme",
  "bugs": {
    "url": "https://github.com/2hoch1/whatsapp-ui-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hoch1/whatsapp-ui-react.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "src",
    "registry.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "registry:build": "shadcn build registry.json --output ../../apps/docs/public/r",
    "clean": "rimraf dist css"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@whatsapp-ui/eslint": "workspace:*",
    "@whatsapp-ui/typescript": "workspace:*",
    "jsdom": "^26.0.0",
    "rimraf": "^6.1.3",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
