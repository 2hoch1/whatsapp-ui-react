{
  "extends": "@whatsapp-ui/typescript/react-library",
  "compilerOptions": {
    "paths": {
      "@/components/ui/*": ["./src/ui/components/*"],
      "@/components/*": ["./src/ui/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "registry"],
  "exclude": ["node_modules", "dist"]
}
